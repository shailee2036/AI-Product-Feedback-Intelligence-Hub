# Supabase project URL and publishable key (safe for the browser by design).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only: FastAPI base URL. Never prefix with NEXT_PUBLIC_.
API_URL=http://127.0.0.1:8000

# Optional: public origin used in email confirmation links (e.g. https://your-app.vercel.app).
SITE_URL=
