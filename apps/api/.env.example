FEEDBACK_HUB_ENVIRONMENT=local

# Fine-grained, read-only token for public repository metadata. Optional; raises rate limits.
FEEDBACK_HUB_GITHUB_TOKEN=

# How many of the most recently updated issues one import stores. 1-500, default 100.
FEEDBACK_HUB_GITHUB_IMPORT_LIMIT=100

# Supabase project URL (Project Settings -> Data API). Used to verify user access tokens via JWKS.
FEEDBACK_HUB_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Postgres "Session pooler" connection string (Connect -> Session pooler).
# The API switches to the `authenticated` role per request, so row-level security applies.
FEEDBACK_HUB_DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres

# Integration tests only: admin URL of the local compose Postgres. Tests create throwaway databases.
FEEDBACK_HUB_TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/postgres

# Gemini API key from Google AI Studio. Required to embed feedback. Free tier is rate limited.
# Emails, phone numbers, and tokens are removed from the text before it is sent.
FEEDBACK_HUB_GEMINI_API_KEY=

# Groq API key from console.groq.com. Required to name themes and write briefs. Free tier is rate limited.
# Only short redacted titles are sent. Feedback bodies stay in the database.
FEEDBACK_HUB_GROQ_API_KEY=
