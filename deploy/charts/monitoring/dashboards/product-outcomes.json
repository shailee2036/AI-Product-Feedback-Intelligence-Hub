{
  "uid": "feedback-hub-outcomes",
  "title": "Product outcomes",
  "description": "Human theme corrections, provider failure and latency, and reported tokens. Configured spend is on the Spend dashboard. Labels never include theme names or ids.",
  "tags": ["feedback-hub", "outcomes"],
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Theme corrections per second",
      "description": "Approvals, dismissals, merges, splits, and relabels.",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (action) (rate(feedback_hub_cluster_corrections_total[$__rate_interval]))",
          "legendFormat": "{{action}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Generation failure ratio",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(feedback_hub_provider_requests_total{operation=~\"theme_names|brief\",result!=\"ok\"}[$__rate_interval])) or vector(0)) / clamp_min(sum(rate(feedback_hub_provider_requests_total{operation=~\"theme_names|brief\"}[$__rate_interval])), 1e-9)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.05 },
              { "color": "red", "value": 0.2 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Generation p95 latency",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(feedback_hub_provider_request_duration_seconds_bucket{operation=~\"theme_names|brief\"}[$__rate_interval])))"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 2 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Reported tokens per second",
      "description": "Tokens the provider reported. This is not a dollar cost.",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(feedback_hub_provider_tokens_total[$__rate_interval])) or vector(0)"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 1 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    }
  ]
}
