{
  "uid": "feedback-hub-spend",
  "title": "Spend",
  "description": "USD from configured per-million rates on successful calls. The rate defaults to zero, so this stays empty until those settings are set. It is not a provider invoice. Tokens are shown beside it.",
  "tags": ["feedback-hub", "spend"],
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "prometheus" },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Configured spend",
      "description": "Increase over the selected range. Zero rates do not add to this counter.",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(feedback_hub_provider_cost_usd_total[$__range])) or vector(0)"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyUSD" }, "overrides": [] }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Spend per second",
      "gridPos": { "x": 8, "y": 0, "w": 16, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operation, provider) (rate(feedback_hub_provider_cost_usd_total[$__rate_interval]))",
          "legendFormat": "{{operation}} {{provider}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyUSD" }, "overrides": [] }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Reported tokens per second",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (direction) (rate(feedback_hub_provider_tokens_total[$__rate_interval]))",
          "legendFormat": "{{direction}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Embedding texts per second",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(feedback_hub_embedding_texts_total[$__rate_interval])) or vector(0)"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    }
  ]
}
